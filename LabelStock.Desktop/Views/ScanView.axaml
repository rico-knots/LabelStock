<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelStock.Desktop.ViewModels"
             x:Class="LabelStock.Desktop.Views.ScanView"
             x:DataType="vm:ScanViewModel">

    <ScrollViewer>
        <StackPanel Margin="40" MaxWidth="880" Spacing="32">

            <!-- Scan box -->
            <Border Classes="card">
                <StackPanel Spacing="24">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <Border Width="72" Height="72" CornerRadius="36"
                                Background="{DynamicResource GreenTintBrush}">
                            <PathIcon Data="{DynamicResource IconBarcode}" Width="38" Height="38"
                                      Foreground="{DynamicResource GreenBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <TextBlock Classes="title" Text="Scan a label" />
                            <TextBlock Classes="subtitle" MaxWidth="640"
                                       Text="Hold the barcode under the scanner. You can also type a number or a name." />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,16,Auto">
                        <!-- The scanner "types" the barcode here and presses Enter. -->
                        <TextBox x:Name="QueryBox" Classes="field"
                                 FontSize="28" MinHeight="72"
                                 Text="{Binding Query}"
                                 PlaceholderText="Barcode or name">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <Button Grid.Column="2" Classes="btn primary big"
                                Command="{Binding SearchCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{DynamicResource IconSearch}" Width="28" Height="28" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Classes="error" Text="{Binding Message}"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Recently scanned / search results -->
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" Text="{Binding ListHeader}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="btn outline" MinHeight="52"
                            Command="{Binding NewLabelCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{DynamicResource IconAdd}" Width="22" Height="22" />
                            <TextBlock Text="Add a new label" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LabelRowViewModel">
                            <Button Classes="row" Command="{Binding OpenCommand}">
                                <Grid ColumnDefinitions="*,Auto,190,Auto">
                                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                IsVisible="{Binding InStock}">
                                        <TextBlock Text="{Binding QuantityText}" FontSize="28" FontWeight="Bold" />
                                        <TextBlock Text="in stock" FontSize="16"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Out of stock" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource RedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               IsVisible="{Binding OutOfStock}" />

                                    <PathIcon Grid.Column="3" Data="{DynamicResource IconChevronRight}"
                                              Width="24" Height="24" Margin="20,0,0,0"
                                              Foreground="{DynamicResource MutedBrush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
