<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelStock.Desktop.ViewModels"
             x:Class="LabelStock.Desktop.Views.SetAdminPasswordView"
             x:DataType="vm:SetAdminPasswordViewModel">

    <ScrollViewer>
        <Border Classes="card" Margin="40,48,40,40" MaxWidth="600" Padding="44">
            <StackPanel Spacing="28">

                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center"
                            Background="{DynamicResource GreenTintBrush}">
                        <PathIcon Data="{DynamicResource IconLock}" Width="44" Height="44"
                                  Foreground="{DynamicResource GreenBrush}" />
                    </Border>
                    <TextBlock Classes="title" Text="Set an admin password" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Classes="subtitle" TextAlignment="Center"
                               Text="There is no admin password yet. Choose one now. You will need it to delete labels and manage backups." />
                </StackPanel>

                <Border Classes="notice warn">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{DynamicResource IconInfo}" Width="26" Height="26" />
                        <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="440"
                                   VerticalAlignment="Center"
                                   Text="Write it down and keep it somewhere safe." />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="New password" />
                    <TextBox x:Name="PasswordBox" Classes="field" MinHeight="72" FontSize="28"
                             PasswordChar="●"
                             RevealPassword="{Binding ShowPassword}"
                             Text="{Binding Password}"
                             PlaceholderText="Type a password" />
                    <TextBlock Classes="hint" Text="{Binding RequirementText}" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="Type it again" />
                    <TextBox Classes="field" MinHeight="72" FontSize="28"
                             PasswordChar="●"
                             RevealPassword="{Binding ShowPassword}"
                             Text="{Binding ConfirmPassword}"
                             PlaceholderText="Type the same password">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </StackPanel>

                <CheckBox FontSize="20" IsChecked="{Binding ShowPassword}" Content="Show what I type" />

                <TextBlock Classes="error" Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Spacing="14">
                    <Button Classes="btn primary big" HorizontalAlignment="Stretch"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{DynamicResource IconCheck}" Width="28" Height="28" />
                            <TextBlock Text="Save password" />
                        </StackPanel>
                    </Button>
                    <Button Classes="btn secondary" MinHeight="64" HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}" Content="Cancel" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
